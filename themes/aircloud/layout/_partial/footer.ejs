
<footer class="footer">
    <ul class="list-inline text-center">
        <% if (config.twitter_username) { %>
        <li>
            <a target="_blank" rel="noopener noreferrer" href="https://twitter.com/<%= config.twitter_username %>">
                            Twitter
            </a>
        </li>
        <% } %>
        <% if (config.zhihu_username) { %>
        <li>
            <a target="_blank" rel="noopener noreferrer" href="https://www.zhihu.com/people/<%= config.zhihu_username %>">
                            知乎
            </a>
        </li>
        <% } %>

        <% if (config.weibo_username) { %>
        <li>
            <a target="_blank" rel="noopener noreferrer" href="http://weibo.com/<%= config.weibo_username %>">
                            微博
            </a>
        </li>
        <% } %>

        <% if (config.facebook_username) { %>
        <li>
            <a target="_blank" rel="noopener noreferrer" href="https://www.facebook.com/<%= config.facebook_username %>">
                            Facebook
            </a>
        </li>
        <% } %>

        <% if (config.github_username) { %>
        <li>
            <a target="_blank" rel="noopener noreferrer" href="https://github.com/<%= config.github_username %>">
                            GitHub
            </a>
        </li>
        <% } %>

        <% if (config.linkedin_username) { %>
        <li>
            <a target="_blank" rel="noopener noreferrer" href="https://www.linkedin.com/in/<%= config.linkedin_username %>">
                            LinkedIn
            </a>
        </li>
        <% } %>

    </ul>
    <% if(config.friends) { %>
    <p>
        <span>/</span>
        <% config.friends.forEach(function(friend){ %>
        <span><a href="<%= friend.href %>"><%= friend.title %></a></span>
        <span>/</span>
        <% }); %>
    </p>
    <% }%>
    <p>
        Created By <a href="https://hexo.io/">Hexo</a>  Theme <a href="https://github.com/aircloud/hexo-theme-aircloud">AirCloud</a></p>
</footer>


