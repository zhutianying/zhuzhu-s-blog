<head>
    <% const pageTitle = page.title ? `${page.title} - ${config.SEOTitle}` : config.SEOTitle; %>
    <% const pageDescription = page.description || config.description; %>
    <% const pageUrl = full_url_for(is_home() ? '' : (page.path || '')); %>
    <% const socialImage = full_url_for(page.cover || config.og_image || 'img/avatar.jpg'); %>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="google-site-verification" content="xBT4GhYoi5qRD5tr338pgPM5OWHHIDR6mNg1a3euekI" />
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="<%= pageDescription %>">
    <meta name="keywords" content="<%= config.keyword %>">
    <link rel="canonical" href="<%= pageUrl %>">
    <meta property="og:title" content="<%= pageTitle %>">
    <meta property="og:description" content="<%= pageDescription %>">
    <meta property="og:type" content="<%= is_post() ? 'article' : 'website' %>">
    <meta property="og:url" content="<%= pageUrl %>">
    <meta property="og:site_name" content="<%= config.SEOTitle %>">
    <meta property="og:image" content="<%= socialImage %>">
    <% if (is_post()) { %><meta property="article:published_time" content="<%= page.date.toISOString() %>"><% } %>
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="<%= pageTitle %>">
    <meta name="twitter:description" content="<%= pageDescription %>">
    <meta name="twitter:image" content="<%= socialImage %>">
    <meta name="theme-color" content="#ffffff">
    <link rel="shortcut icon" href="<%= config.root %>img/favicon.ico">

    <title>
        <%= pageTitle %>
    </title>

    <!-- Custom CSS -->
    <%- css('css/aircloud.css') %>
    <link href="//at.alicdn.com/t/font_620856_28hi1hpxx24.css" rel="stylesheet" type="text/css">
    <!-- ga & ba script hoook -->
    <script></script>
</head>
